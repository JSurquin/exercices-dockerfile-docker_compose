generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String                  @id @default(cuid())
  email                    String                  @unique
  emailVerified            Boolean                 @default(false)
  name                     String?
  image                    String?
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  steamId                  String?                 @unique
  steamUsername            String?
  steamAvatar              String?
  level                    Int                     @default(1)
  xp                       Int                     @default(0)
  tickets                  Int                     @default(0)
  totalVolumeCents         Int                     @default(0)
  kycStatus                KycStatus               @default(PENDING)
  acceptedTermsAt          DateTime?
  role                     UserRole                @default(USER)
  referredByAffiliateId    String?
  isFirstLogin             Boolean                 @default(true)
  tradeLink                String?
  kycaidApplicantId        String?                 @unique
  balanceCents             Int                     @default(0)
  frozenBalanceCents       Int                     @default(0)
  accountFrozen            Boolean                 @default(false)
  adminMetadata            Json?
  pendingBalanceCents      Int                     @default(0)
  fragments                Int                     @default(0)
  /// Bonus de vente débloqué par niveau cosmique (ex: 0.0075 = +0.75%)
  saleBonus                Float                   @default(0.0)
  /// Palier actuel 0-29 (6 niveaux × 5 paliers)
  currentTier              Int                     @default(0)
  twoFactorEnabled         Boolean                 @default(false)
  banned                   Boolean                 @default(false)
  banReason                String?
  banExpires               DateTime?
  lastLoginIp              String?
  lastLoginAt              DateTime?
  contactEmail             String?
  /// Bonus VIP en % sur la valeur brute du trade (ex: 2.0 = +2%)
  bonusRatePercent         Float                   @default(0)
  /// Tag affiché dans l'admin et sur le profil (VIP, MERCHANT, etc.)
  userTag                  String?
  /// Crédit instantané : si activé, le solde est crédité immédiatement (sans attendre le trade hold 7j)
  instantCreditEnabled     Boolean                 @default(false)
  /// Bloque commissions affilié, promo affilié et fragments promo pour cet utilisateur
  affiliateRewardsBlocked  Boolean                 @default(false)
  /// Bloque XP, tickets et fragments liés aux ventes pour cet utilisateur
  xpRewardsBlocked         Boolean                 @default(false)
  reviewedApplications     AffiliateApplication[]  @relation("AffiliateApplicationReviewer")
  affiliateApplications    AffiliateApplication[]
  referrals                AffiliateReferral[]     @relation("AffiliateReferrals")
  affiliateStats           AffiliateStats?
  giveawayEntries          GiveawayEntry[]
  paymentMethods           PaymentMethod[]
  payouts                  Payout[]
  trades                   Trade[]
  accounts                 Account[]
  balanceTransactions      BalanceTransaction[]
  chatMessages             ChatMessage[]
  assignedConversations    Conversation[]          @relation("AssignedConversations")
  conversations            Conversation[]
  dailyLogins              DailyLogin[]
  fragmentTransactions     FragmentTransaction[]
  kycDocuments             KycDocument[]
  kycVerifications         KycVerification[]
  pointTransactions        PointTransaction[]
  sessions                 Session[]
  twoFactor                TwoFactor?
  missionCompletions       UserMissionCompletion[]
  withdrawalLimit          WithdrawalLimit?
  notifications            Notification[]
  notificationPreferences  NotificationPreferences?
  affiliateGiveawayRequests AffiliateGiveawayRequest[] @relation("AffiliateGiveawayRequestUser")
  reviewedAffiliateGiveawayRequests AffiliateGiveawayRequest[] @relation("AffiliateGiveawayRequestReviewer")
  affiliateHistory         UserAffiliateHistory[]

  @@map("user")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  details   Json
  createdAt DateTime @default(now())
  ipAddress String?

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_log")
}

model BlockedIp {
  id        String    @id @default(cuid())
  ipAddress String    @unique
  reason    String
  createdBy String
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([ipAddress])
  @@index([expiresAt])
  @@map("blocked_ip")
}

model BalanceTransaction {
  id                String                 @id @default(cuid())
  userId            String
  type              BalanceTransactionType
  amountCents       Int
  balanceAfterCents Int
  reason            String?
  createdBy         String?
  metadata          Json?
  createdAt         DateTime               @default(now())
  user              User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([type])
  @@map("balance_transaction")
}

model WithdrawalLimit {
  id                String   @id @default(cuid())
  userId            String   @unique
  monthlyLimitCents Int
  updatedBy         String?
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("withdrawal_limit")
}

model Trade {
  id                 String              @id @default(cuid())
  userId             String
  status             TradeStatus         @default(CREATED)
  grossCents         Int
  cashoutFees        Int
  networkFees        Int
  netCents           Int
  /// Code affilié utilisé comme promo sur cette vente (si applicable)
  affiliatePromoCode              String?
  /// Parrain actif au moment de la vente (snapshot — fige la commission même si transfert ultérieur)
  affiliateAttributionCode        String?
  /// Bonus net (centimes) = 0,2 % de la valeur brute, crédité avec le trade
  affiliatePromoBonusCents        Int       @default(0)
  /// Bonus VIP (centimes) = bonusRatePercent % de la valeur brute
  vipBonusCents                    Int       @default(0)
  /// Horodatage crédit fragments promo (idempotence)
  affiliatePromoFragmentsGrantedAt DateTime?
  /// Horodatage du crédit pending balance (IPN #1) — sert de verrou d'idempotence
  pendingCreditedAt  DateTime?
  /// Horodatage du crédit balance réel (IPN #2 confirmed) — sert de verrou d'idempotence
  balanceCreditedAt  DateTime?
  /// Horodatage du revert pending balance (IPN #2 rollback) — sert de verrou d'idempotence
  pendingRevertedAt  DateTime?
  /// Horodatage du traitement post-PAID — verrou d'idempotence (legacy)
  paidProcessedAt    DateTime?
  /// Horodatage attribution commission affilié (après validation 7j / statut AVAILABLE)
  affiliateCommissionProcessedAt DateTime?
  /// Horodatage du crédit instantané (verrou d'idempotence pour éviter le double-crédit avec onTradeAvailable)
  instantCreditedAt  DateTime?
  /// Montant EUR crédité au moment du trade (verrouillé à IPN#1 pour cohérence release/rollback)
  eurCentsAtCredit   Int?
  /// Taux USD→EUR utilisé lors du crédit initial (pour audit et cohérence)
  usdToEurRate       Float?
  ticketId           String              @unique
  tradeAcceptedAt    DateTime?
  availableAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  steamId            String
  tradeUrl           String?
  expiresAt          DateTime?
  skinplaceToken     String?
  affiliateReferrals AffiliateReferral[]
  affiliateCommissions AffiliateCommission[]
  payouts            Payout[]
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  items              TradeItem[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model TradeItem {
  id             String  @id @default(cuid())
  tradeId        String
  name           String
  marketHashName String
  priceCents     Int
  iconUrl        String
  exterior       String?
  statTrak       Boolean @default(false)
  rarity         String
  trade          Trade   @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  @@index([tradeId])
}

model PaymentMethod {
  id         String            @id @default(cuid())
  userId     String
  type       PaymentMethodType
  details    Json
  isVerified Boolean           @default(false)
  isDefault  Boolean           @default(false)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  payouts    Payout[]

  @@index([userId])
}

model Payout {
  id                             String                @id @default(cuid())
  userId                         String
  tradeId                        String?
  status                         PayoutStatus          @default(PENDING)
  amountCents                    Int
  paymentMethodId                String
  paymentReference               String?
  txId                           String?
  createdAt                      DateTime              @default(now())
  updatedAt                      DateTime              @updatedAt
  paidAt                         DateTime?
  gateFiOrderId                  String?               @unique
  gateFiWidgetUrl                String?
  errorMessage                   String?
  flexifyPayoutId                String?               @unique
  networkFeeCents                Int?
  processingFeeCents             Int?
  whitepayAddress                String?
  whitepayConfirmedAt            DateTime?
  whitepayEstimatedAt            DateTime?
  whitepayExchangeRate           String?
  whitepayFee                    String?
  whitepayMemo                   String?
  whitepayNetwork                String?
  whitepayStatus                 String?
  whitepayTargetCurrency         String?
  whitepayTargetValue            String?
  whitepayTransactionId          String?               @unique
  whitepayTxHash                 String?
  pendingFlexifyRequestEncrypted String?
  /// Horodatage du gel de balance à la création du payout — verrou d'idempotence
  balanceFrozenAt                DateTime?
  /// Horodatage du débit de balance au webhook succès — verrou d'idempotence
  balanceDebitedAt               DateTime?
  affiliateCommissions           AffiliateCommission[]
  paymentMethod                  PaymentMethod         @relation(fields: [paymentMethodId], references: [id])
  trade                          Trade?                @relation(fields: [tradeId], references: [id])
  user                           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([gateFiOrderId])
  @@index([flexifyPayoutId])
  @@index([whitepayTransactionId])
}

model KycDocument {
  id                String          @id @default(cuid())
  userId            String
  type              KycDocumentType
  status            KycStatus       @default(PENDING)
  kycaidApplicantId String
  uploadedAt        DateTime        @default(now())
  reviewedAt        DateTime?
  rejectionReason   String?
  metadata          Json?
  verificationId    String?
  kycaidDocumentId  String?         @unique
  isVerified        Boolean         @default(false)
  verifiedAt        DateTime?
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  files             KycFile[]

  @@index([userId])
  @@index([status])
  @@index([kycaidApplicantId])
  @@index([kycaidDocumentId])
  @@index([verificationId])
  @@index([kycaidApplicantId], map: "KycDocument_providerId_idx")
  @@index([verificationId], map: "KycDocument_verificationId_idx")
  @@map("kyc_document")
}

model KycFile {
  id               String      @id @default(cuid())
  documentId       String
  fileName         String
  fileType         String
  fileSize         Int
  side             KycFileSide
  kycaidFileId     String?     @unique
  uploadedToKycaid Boolean     @default(false)
  localPath        String?
  createdAt        DateTime    @default(now())
  uploadedAt       DateTime?
  document         KycDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([kycaidFileId])
  @@map("kyc_file")
}

model KycAddress {
  id                 String         @id @default(cuid())
  applicantId        String?
  affiliatedPersonId String?
  type               KycAddressType
  country            String
  city               String
  postalCode         String
  streetName         String
  buildingNumber     String
  unitNumber         String?
  stateOrProvince    String?
  fullAddress        String?
  kycaidAddressId    String?        @unique
  isVerified         Boolean        @default(false)
  verifiedAt         DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([applicantId])
  @@index([type])
  @@index([kycaidAddressId])
  @@map("kyc_address")
}

model KycVerification {
  id                   String                   @id @default(cuid())
  userId               String
  kycaidVerificationId String                   @unique
  kycaidApplicantId    String
  status               KycaidVerificationStatus
  verified             Boolean                  @default(false)
  formUrl              String?
  documentStatus       String?
  documentVerified     Boolean?
  facialStatus         String?
  facialVerified       Boolean?
  addressStatus        String?
  addressVerified      Boolean?
  amlStatus            String?
  amlVerified          Boolean?
  declineReasons       Json?
  metadata             Json?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  completedAt          DateTime?
  user                 User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([kycaidVerificationId])
  @@index([status])
  @@index([verified])
  @@map("kyc_verification")
}

model KycAffiliatedPerson {
  id                 String         @id @default(cuid())
  companyApplicantId String
  kycaidAffiliatedId String         @unique
  firstName          String
  lastName           String
  email              String
  dob                String
  nationality        String?
  residenceCountry   String?
  role               AffiliatedRole
  sharePercentage    Float?
  addressJson        Json?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([companyApplicantId])
  @@index([kycaidAffiliatedId])
  @@map("kyc_affiliated_person")
}

model AffiliateStats {
  id                   String                @id @default(cuid())
  userId               String                @unique
  code                 String                @unique
  totalReferrals       Int                   @default(0)
  totalVolumeCents     Int                   @default(0)
  totalCommissionCents Int                   @default(0)
  commissionRate       Float                 @default(0.02)
  isActive             Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  commissions          AffiliateCommission[]
  referrals            AffiliateReferral[]
  giveawayRequests     AffiliateGiveawayRequest[]
  affiliateHistory     UserAffiliateHistory[]
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([code])
  @@index([isActive])
}

model AffiliateReferral {
  id              String                @id @default(cuid())
  affiliateId     String
  referredUserId  String
  tradeId         String?
  volumeCents     Int                   @default(0)
  commissionCents Int                   @default(0)
  /// false lorsque le filleul a changé d'affilié
  isActive        Boolean               @default(true)
  churnedAt       DateTime?
  createdAt       DateTime              @default(now())
  commissions     AffiliateCommission[]
  affiliate       AffiliateStats        @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  referredUser    User                  @relation("AffiliateReferrals", fields: [referredUserId], references: [id], onDelete: Cascade)
  trade           Trade?                @relation(fields: [tradeId], references: [id])

  @@index([affiliateId])
  @@index([referredUserId])
  @@index([createdAt])
  @@index([isActive])
}

/// Historique des affiliés utilisés par un utilisateur (parcours influenceur → influenceur)
model UserAffiliateHistory {
  id            String         @id @default(cuid())
  userId        String
  affiliateId   String
  affiliateCode String
  startedAt     DateTime       @default(now())
  endedAt       DateTime?
  isActive      Boolean        @default(true)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  affiliate     AffiliateStats @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([affiliateId])
  @@index([isActive])
  @@index([startedAt])
  @@map("user_affiliate_history")
}

model AffiliateCommission {
  id              String                    @id @default(cuid())
  affiliateId     String
  referralId      String?
  tradeId         String?
  /// Code affilié utilisé pour cette vente (snapshot)
  affiliateCode   String?
  /// Taux appliqué au moment de l'attribution (snapshot)
  commissionRate  Float?
  amountCents     Int
  status          AffiliateCommissionStatus @default(PENDING)
  payoutId        String?
  /// Horodatage du crédit sur balanceCents — verrou d'idempotence
  balanceCreditedAt DateTime?
  createdAt       DateTime                  @default(now())
  paidAt          DateTime?
  affiliate       AffiliateStats            @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  payout          Payout?                   @relation(fields: [payoutId], references: [id])
  referral        AffiliateReferral?        @relation(fields: [referralId], references: [id])
  trade           Trade?                    @relation(fields: [tradeId], references: [id])

  @@unique([tradeId])
  @@index([affiliateId])
  @@index([status])
  @@index([createdAt])
}

model AffiliateApplication {
  id              String                     @id @default(cuid())
  userId          String
  motivation      String
  socialLinks     Json?
  status          AffiliateApplicationStatus @default(PENDING)
  reviewedBy      String?
  reviewedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  reviewer        User?                      @relation("AffiliateApplicationReviewer", fields: [reviewedBy], references: [id])
  user            User                       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model AffiliateGiveawayRequest {
  id                  String                         @id @default(cuid())
  affiliateId         String
  userId              String
  startDate           DateTime
  endDate             DateTime
  winnerCount         Int
  costCents           Int
  adminMessage        String?
  /// Si true, le giveaway créé sera privé et réservé au code affilié
  requireAffiliateCode Boolean                       @default(true)
  status              AffiliateGiveawayRequestStatus @default(PENDING)
  giveawayId          String?                        @unique
  prize               String?
  prizeImageUrl       String?
  steamMarketHashName String?
  rewardValueCents    Int?
  reviewedBy          String?
  reviewedAt          DateTime?
  rejectionReason     String?
  createdAt           DateTime                       @default(now())
  updatedAt           DateTime                       @updatedAt
  affiliate           AffiliateStats                 @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  user                User                           @relation("AffiliateGiveawayRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  giveaway            Giveaway?                      @relation(fields: [giveawayId], references: [id], onDelete: SetNull)
  reviewer            User?                          @relation("AffiliateGiveawayRequestReviewer", fields: [reviewedBy], references: [id])

  @@index([affiliateId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("affiliate_giveaway_request")
}

model GiveawaySeries {
  id                    String               @id @default(cuid())
  title                 String
  description           String
  prize                 String
  prizeImageUrl         String?
  steamMarketHashName   String?
  ticketPrice           Int
  maxTickets            Int
  /// Durée de chaque instance en minutes
  durationMinutes       Int
  frequency             GiveawayDurationType
  winnerCount           Int                  @default(1)
  maxEntriesPerUser     Int?
  rewardValueCents      Int                  @default(0)
  isPrivate             Boolean              @default(false)
  requiredAffiliateCode String?
  status                GiveawaySeriesStatus @default(ACTIVE)
  startDate             DateTime
  endDate               DateTime?
  lastSpawnAt           DateTime?
  nextSpawnAt           DateTime?
  spawnCount            Int                  @default(0)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  instances             Giveaway[]

  @@index([status])
  @@index([nextSpawnAt])
  @@map("giveaway_series")
}

model Giveaway {
  id                    String               @id @default(cuid())
  title                 String
  description           String
  prize                 String
  /// Coût d’une entrée en fragments (anciennement « ticket »)
  ticketPrice           Int
  maxTickets            Int
  soldTickets           Int                  @default(0)
  startDate             DateTime?
  endDate               DateTime
  status                GiveawayStatus       @default(ACTIVE)
  winnerId              String?
  randomSeed            String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  durationType          GiveawayDurationType @default(CUSTOM)
  maxEntriesPerUser     Int?
  /// Coût réel du lot en centimes (KPI admin)
  rewardValueCents      Int                  @default(0)
  winnerCount           Int                  @default(1)
  /// URL image Steam (community.cloudflare.steamstatic.com) du lot
  prizeImageUrl         String?
  /// steam_market_hash_name du lot
  steamMarketHashName   String?
  isPrivate             Boolean              @default(false)
  requiredAffiliateCode String?
  seriesId              String?
  series                GiveawaySeries?      @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  affiliateGiveawayRequest AffiliateGiveawayRequest?
  entries               GiveawayEntry[]
  winners               GiveawayWinner[]

  @@index([status])
  @@index([endDate])
  @@index([durationType])
  @@index([isPrivate])
  @@index([seriesId])
}

model GiveawayEntry {
  id          String   @id @default(cuid())
  userId      String
  giveawayId  String
  /// Nombre d’entrées (tickets pondérés au tirage)
  ticketsUsed Int
  enteredAt   DateTime @default(now())
  giveaway    Giveaway @relation(fields: [giveawayId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, giveawayId])
  @@index([giveawayId])
}

model GiveawayWinner {
  id         String   @id @default(cuid())
  giveawayId String
  userId     String
  rank       Int      @default(1)
  createdAt  DateTime @default(now())
  giveaway   Giveaway @relation(fields: [giveawayId], references: [id], onDelete: Cascade)

  @@unique([giveawayId, userId])
  @@index([giveawayId])
  @@map("giveaway_winner")
}

model FragmentTransaction {
  id        String                  @id @default(cuid())
  userId    String
  type      FragmentTransactionType
  amount    Int
  reason    String?
  metadata  Json?
  createdAt DateTime                @default(now())
  user      User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@map("fragment_transaction")
}

model UserMissionCompletion {
  id              String   @id @default(cuid())
  userId          String
  missionKey      String
  periodKey       String
  rewardFragments Int
  completedAt     DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, missionKey, periodKey])
  @@index([userId])
  @@map("user_mission_completion")
}

model PointTransaction {
  id        String         @id @default(cuid())
  userId    String
  type      PointEventType
  points    Int
  tickets   Int            @default(0)
  reason    String?
  metadata  Json?
  createdAt DateTime       @default(now())
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@map("point_transaction")
}

model DailyLogin {
  id        String   @id @default(cuid())
  userId    String
  loginDate DateTime @default(now()) @db.Date
  streak    Int      @default(1)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, loginDate])
  @@index([userId])
  @@index([loginDate])
  @@map("daily_login")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("verification")
}

model TwoFactor {
  id          String   @id
  userId      String   @unique
  secret      String
  backupCodes String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("twoFactor")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  impersonatedBy String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model NewsletterSubscriber {
  id               String    @id @default(cuid())
  email            String    @unique
  isActive         Boolean   @default(true)
  subscribedAt     DateTime  @default(now())
  unsubscribedAt   DateTime?
  unsubscribeToken String    @unique @default(cuid())

  @@index([email])
  @@index([isActive])
  @@map("newsletter_subscriber")
}

model NewsletterCampaign {
  id          String           @id @default(cuid())
  title       String
  subject     String
  content     String
  htmlContent String?
  status      NewsletterStatus @default(DRAFT)
  scheduledAt DateTime?
  sentAt      DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  createdBy   String
  sends       NewsletterSend[]

  @@index([status])
  @@index([scheduledAt])
  @@map("newsletter_campaign")
}

model NewsletterSend {
  id           String               @id @default(cuid())
  campaignId   String
  email        String
  status       NewsletterSendStatus @default(PENDING)
  sentAt       DateTime?
  openedAt     DateTime?
  clickedAt    DateTime?
  errorMessage String?
  campaign     NewsletterCampaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([email])
  @@index([status])
  @@map("newsletter_send")
}

model Conversation {
  id                String               @id @default(cuid())
  userId            String?
  status            ConversationStatus   @default(ACTIVE)
  subject           String?
  category          String?
  priority          ConversationPriority @default(NORMAL)
  assignedTo        String?
  summary           String?
  lastMessageAt     DateTime?
  deletedAt         DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  closedAt          DateTime?
  messages          ChatMessage[]
  assignedModerator User?                @relation("AssignedConversations", fields: [assignedTo], references: [id])
  user              User?                @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([userId, lastMessageAt])
  @@index([status])
  @@index([assignedTo])
  @@index([createdAt])
  @@index([lastMessageAt])
  @@map("conversation")
}

model ChatMessage {
  id             String       @id @default(cuid())
  conversationId String
  userId         String?
  content        String
  senderType     SenderType
  isRead         Boolean      @default(false)
  metadata       Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id])

  @@index([conversationId])
  @@index([conversationId, createdAt])
  @@index([userId])
  @@index([createdAt])
  @@index([senderType])
  @@map("chat_message")
}

model LegalPage {
  id           String   @id @default(cuid())
  slug         String   @unique
  titleFr      String
  subtitleFr   String?
  contentFr    String
  titleEn      String
  subtitleEn   String?
  contentEn    String
  version      String   @default("1.0")
  isPublished  Boolean  @default(true)
  contactEmail String?
  contactPhone String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  updatedBy    String?
  contentCn    String?
  subtitleCn   String?
  titleCn      String?

  @@index([slug])
  @@index([isPublished])
  @@map("legal_page")
}

model LegalPageHistory {
  id            String   @id @default(cuid())
  legalPageId   String
  legalPageSlug String
  titleFr       String
  titleEn       String
  contentFr     String
  contentEn     String
  version       String
  changedBy     String
  changedAt     DateTime @default(now())
  changeReason  String?
  contentCn     String?
  titleCn       String?

  @@index([legalPageId])
  @@index([changedAt])
  @@map("legal_page_history")
}

model SiteSettings {
  id          String   @id @default(cuid())
  key         String   @unique
  valueFr     String?
  valueEn     String?
  valueJson   Json?
  description String?
  updatedAt   DateTime @updatedAt
  updatedBy   String?

  @@index([key])
  @@map("site_settings")
}

