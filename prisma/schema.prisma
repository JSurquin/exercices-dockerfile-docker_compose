generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "rhel-openssl-3.0.x"]
  // output        = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String              @id @default(cuid())
  email                 String              @unique
  emailVerified         Boolean             @default(false)
  name                  String?
  image                 String?
  tradeLink             String?             @unique
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  role                  UserRole            @default(USER)
  steamId               String?             @unique
  steamUsername         String?
  steamAvatar           String?
  level                 Int                 @default(1)
  xp                    Int                 @default(0)
  tickets               Int                 @default(0)
  totalVolumeCents      Int                 @default(0)
  balanceCents          Int                 @default(0)
  pendingBalanceCents   Int                 @default(0)
  frozenBalanceCents     Int                 @default(0)
  accountFrozen          Boolean             @default(false)
  kycStatus             KycStatus           @default(PENDING)
  kycaidApplicantId     String?             @unique // KYCAID applicant ID
  acceptedTermsAt       DateTime?
  isFirstLogin          Boolean             @default(true)
  twoFactorEnabled      Boolean             @default(false)
  referredByAffiliateId String?
  adminMetadata         Json?               // Notifications, preferences, security settings for admin
  affiliateStats        AffiliateStats?
  balanceTransactions   BalanceTransaction[]
  withdrawalLimit        WithdrawalLimit?
  affiliateApplications AffiliateApplication[]
  reviewedApplications  AffiliateApplication[] @relation("AffiliateApplicationReviewer")
  giveawayEntries       GiveawayEntry[]
  pointTransactions     PointTransaction[]
  dailyLogins           DailyLogin[]
  kycDocuments          KycDocument[]
  kycVerifications      KycVerification[]
  paymentMethods        PaymentMethod[]
  payouts               Payout[]
  trades                Trade[]
  accounts              Account[]
  sessions              Session[]
  referrals             AffiliateReferral[] @relation("AffiliateReferrals")
  conversations         Conversation[]
  assignedConversations Conversation[] @relation("AssignedConversations")
  chatMessages          ChatMessage[]
  twoFactor             TwoFactor?

  @@map("user")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  details   Json
  createdAt DateTime @default(now())
  ipAddress String?

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_log")
}

model BalanceTransaction {
  id               String                   @id @default(cuid())
  userId           String
  type             BalanceTransactionType
  amountCents      Int
  balanceAfterCents Int
  reason           String?
  createdBy        String?
  metadata         Json?
  createdAt        DateTime                @default(now())
  user             User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([type])
  @@map("balance_transaction")
}

model WithdrawalLimit {
  id                 String   @id @default(cuid())
  userId             String   @unique
  monthlyLimitCents  Int
  updatedBy          String?
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("withdrawal_limit")
}

model Trade {
  id                 String              @id @default(cuid())
  userId             String
  status             TradeStatus         @default(CREATED)
  grossCents         Int
  cashoutFees        Int
  networkFees        Int
  steamId            String
  netCents           Int
  ticketId           String              @unique
  skinplaceToken     String?
  tradeAcceptedAt    DateTime?
  tradeUrl           String?
  expiresAt          DateTime?
  availableAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  payouts            Payout[]
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  items              TradeItem[]
  affiliateReferrals AffiliateReferral[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model TradeItem {
  id             String  @id @default(cuid())
  tradeId        String
  name           String
  marketHashName String
  priceCents     Int
  iconUrl        String
  exterior       String?
  statTrak       Boolean @default(false)
  rarity         String
  trade          Trade   @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  @@index([tradeId])
}

model PaymentMethod {
  id         String            @id @default(cuid())
  userId     String
  type       PaymentMethodType
  details    Json
  isVerified Boolean           @default(false)
  isDefault  Boolean           @default(false)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  payouts    Payout[]

  @@index([userId])
}

model Payout {
  id                   String                @id @default(cuid())
  userId               String
  tradeId              String?
  status               PayoutStatus          @default(PENDING)
  amountCents          Int
  paymentMethodId      String
  paymentReference     String?
  txId                 String?
  gateFiOrderId        String?               @unique // Réutilisé pour Flexify orderId
  gateFiWidgetUrl      String?
  flexifyPayoutId      String?               @unique // ID Flexify du payout
  // Whitepay fields
  whitepayTransactionId String?              @unique // ID transaction Whitepay
  whitepayStatus        String?              // Statut brut Whitepay (WAITING_CONFIRMATION, etc.)
  whitepayExchangeRate  String?              // Taux de change appliqué
  whitepayTargetValue   String?              // Montant en crypto reçu
  whitepayTargetCurrency String?             // Ticker crypto (USDT, BTC, etc.)
  whitepayNetwork       String?              // Réseau blockchain (ERC20, TRC20, etc.)
  whitepayAddress       String?              // Adresse wallet destination
  whitepayMemo          String?              // Memo/tag si applicable
  whitepayTxHash        String?              // Hash de la transaction blockchain
  whitepayFee           String?              // Frais Whitepay
  whitepayEstimatedAt   DateTime?            // Timestamp estimation du taux
  whitepayConfirmedAt   DateTime?            // Timestamp confirmation
  processingFeeCents   Int?                  // Frais de traitement
  networkFeeCents      Int?                  // Frais réseau
  errorMessage         String?               // Message d'erreur si échec
  // Payload chiffré pour exécution différée (Flexify carte/SEPA en PENDING_APPROVAL)
  pendingFlexifyRequestEncrypted String?     // Données pour createCardPayout/createSepaPayout à l'approbation admin
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  paidAt               DateTime?
  paymentMethod        PaymentMethod         @relation(fields: [paymentMethodId], references: [id])
  trade                Trade?                @relation(fields: [tradeId], references: [id])
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  affiliateCommissions AffiliateCommission[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([gateFiOrderId])
  @@index([flexifyPayoutId])
  @@index([whitepayTransactionId])
}

model KycDocument {
  id                  String          @id @default(cuid())
  userId              String
  type                KycDocumentType
  status              KycStatus       @default(PENDING)
  
  // KYCAID IDs (renommer providerId)
  kycaidApplicantId   String          // Applicant auquel appartient ce doc
  kycaidDocumentId    String?         @unique // ID du document côté KYCAID
  verificationId      String?         // ID de la vérification associée
  
  // Fichiers liés (relation)
  files               KycFile[]
  
  // Résultat de vérification
  isVerified          Boolean         @default(false)
  verifiedAt          DateTime?
  rejectionReason     String?
  
  // Métadonnées complètes KYCAID
  metadata            Json?           // Réponse API complète
  
  // Audit
  uploadedAt          DateTime        @default(now())
  reviewedAt          DateTime?
  
  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([status])
  @@index([kycaidApplicantId])
  @@index([kycaidDocumentId])
  @@index([verificationId])
  @@map("kyc_document")
}

model KycFile {
  id              String       @id @default(cuid())
  
  // Lien vers le document parent
  documentId      String
  document        KycDocument  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  
  // Métadonnées fichier
  fileName        String
  fileType        String       // jpg, png, pdf
  fileSize        Int
  side            KycFileSide  // FRONT, BACK, SELFIE
  
  // ID KYCAID
  kycaidFileId    String?      @unique // ID retourné après création
  uploadedToKycaid Boolean     @default(false)
  
  // URLs (si stockage local temporaire)
  localPath       String?      // Chemin temporaire avant upload
  
  // Audit
  createdAt       DateTime     @default(now())
  uploadedAt      DateTime?
  
  @@index([documentId])
  @@index([kycaidFileId])
  @@map("kyc_file")
}

model KycAddress {
  id                String   @id @default(cuid())
  
  // Rattachement
  applicantId       String?  // User.kycaidApplicantId
  affiliatedPersonId String? // Pour KYB (futurs dirigeants)
  type              KycAddressType
  
  // Champs obligatoires KYCAID API
  country           String   // Code ISO 2 lettres
  city              String
  postalCode        String
  streetName        String
  buildingNumber    String
  
  // Champs optionnels
  unitNumber        String?
  stateOrProvince   String?
  fullAddress       String?
  
  // Métadonnées KYCAID
  kycaidAddressId   String?  @unique // ID retourné par l'API
  isVerified        Boolean  @default(false)
  verifiedAt        DateTime?
  
  // Audit
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@index([applicantId])
  @@index([type])
  @@index([kycaidAddressId])
  @@map("kyc_address")
}

model KycVerification {
  id                    String   @id @default(cuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // IDs KYCAID
  kycaidVerificationId  String   @unique
  kycaidApplicantId     String
  
  // État global
  status                KycaidVerificationStatus
  verified              Boolean  @default(false)
  formUrl               String?  // URL du formulaire KYCAID
  
  // Résultats par composante
  documentStatus        String?
  documentVerified      Boolean?
  facialStatus          String?
  facialVerified        Boolean?
  addressStatus         String?
  addressVerified       Boolean?
  amlStatus             String?
  amlVerified           Boolean?
  
  // Raisons de refus
  declineReasons        Json?
  
  // Métadonnées complètes
  metadata              Json?
  
  // Dates
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  completedAt           DateTime?
  
  @@index([userId])
  @@index([kycaidVerificationId])
  @@index([status])
  @@index([verified])
  @@map("kyc_verification")
}

model KycAffiliatedPerson {
  id                    String              @id @default(cuid())
  
  // Lien vers l'entreprise (applicant parent)
  companyApplicantId    String
  
  // ID KYCAID
  kycaidAffiliatedId    String              @unique
  
  // Identité
  firstName             String
  lastName              String
  email                 String
  dob                   String              // YYYY-MM-DD
  nationality           String?
  residenceCountry      String?
  
  // Rôle dans l'entreprise
  role                  AffiliatedRole
  sharePercentage       Float?              // Pour UBO (bénéficiaires effectifs)
  
  // Adresse personnelle (peut pointer vers KycAddress si nécessaire)
  addressJson           Json?
  
  // Audit
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  
  @@index([companyApplicantId])
  @@index([kycaidAffiliatedId])
  @@map("kyc_affiliated_person")
}

model AffiliateStats {
  id                   String                @id @default(cuid())
  userId               String                @unique
  code                 String                @unique
  totalReferrals       Int                   @default(0)
  totalVolumeCents     Int                   @default(0)
  totalCommissionCents Int                   @default(0)
  commissionRate       Float                 @default(0.02)
  isActive             Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  referrals            AffiliateReferral[]
  commissions          AffiliateCommission[]

  @@index([code])
  @@index([isActive])
}

model AffiliateReferral {
  id              String   @id @default(cuid())
  affiliateId     String
  referredUserId  String
  tradeId         String?
  volumeCents     Int      @default(0)
  commissionCents Int      @default(0)
  createdAt       DateTime @default(now())

  affiliate    AffiliateStats        @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  referredUser User                  @relation("AffiliateReferrals", fields: [referredUserId], references: [id], onDelete: Cascade)
  trade        Trade?                @relation(fields: [tradeId], references: [id])
  commissions  AffiliateCommission[]

  @@index([affiliateId])
  @@index([referredUserId])
  @@index([createdAt])
}

model AffiliateCommission {
  id          String                    @id @default(cuid())
  affiliateId String
  referralId  String?
  amountCents Int
  status      AffiliateCommissionStatus @default(PENDING)
  payoutId    String?
  createdAt   DateTime                  @default(now())
  paidAt      DateTime?

  affiliate AffiliateStats     @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  referral  AffiliateReferral? @relation(fields: [referralId], references: [id])
  payout    Payout?            @relation(fields: [payoutId], references: [id])

  @@index([affiliateId])
  @@index([status])
  @@index([createdAt])
}

model AffiliateApplication {
  id            String                      @id @default(cuid())
  userId        String
  motivation    String
  socialLinks   Json?
  status        AffiliateApplicationStatus  @default(PENDING)
  reviewedBy    String?
  reviewedAt    DateTime?
  rejectionReason String?
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt
  user          User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewer      User?                       @relation("AffiliateApplicationReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model Giveaway {
  id          String          @id @default(cuid())
  title       String
  description String
  prize       String
  ticketPrice Int
  maxTickets  Int
  soldTickets Int             @default(0)
  endDate     DateTime
  status      GiveawayStatus  @default(ACTIVE)
  winnerId    String?
  randomSeed  String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  entries     GiveawayEntry[]

  @@index([status])
  @@index([endDate])
}

model GiveawayEntry {
  id          String   @id @default(cuid())
  userId      String
  giveawayId  String
  ticketsUsed Int
  enteredAt   DateTime @default(now())
  giveaway    Giveaway @relation(fields: [giveawayId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, giveawayId])
  @@index([giveawayId])
}

// Historique des transactions de points (XP/tickets gamification)
model PointTransaction {
  id          String            @id @default(cuid())
  userId      String
  type        PointEventType
  points      Int               // Points gagnés (positif) ou dépensés (négatif)
  tickets     Int               @default(0) // Tickets gagnés
  reason      String?           // Libellé affiché à l'utilisateur
  metadata    Json?             // Données contextuelles (tradeId, etc.)
  createdAt   DateTime          @default(now())
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@map("point_transaction")
}

// Connexions quotidiennes pour le bonus daily login
model DailyLogin {
  id        String   @id @default(cuid())
  userId    String
  loginDate DateTime @default(now()) @db.Date
  streak    Int      @default(1) // Nombre de jours consécutifs
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, loginDate])
  @@index([userId])
  @@index([loginDate])
  @@map("daily_login")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("verification")
}

model TwoFactor {
  id          String   @id
  userId      String   @unique
  secret      String
  backupCodes String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("twoFactor")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

enum TradeStatus {
  CREATED
  ACCEPTED_BY_BOT
  IN_TRADE_HOLD
  AVAILABLE
  PAYOUT_PENDING
  PAID
  FAILED
  CANCELLED
}

enum PayoutStatus {
  PENDING
  PENDING_APPROVAL
  VERIFICATION_REQUIRED
  VERIFIED
  SCHEDULED
  PROCESSING
  PAID
  FAILED
  // Flexify specific statuses
  FLEXIFY_PENDING
  FLEXIFY_PROCESSING
  FLEXIFY_PAID
  FLEXIFY_FAILED
  // Whitepay specific statuses
  WHITEPAY_WAITING_CONFIRMATION
  WHITEPAY_PENDING_WITHDRAWAL
  CANCELLED
  WHITEPAY_PROCESSING_WITHDRAWAL
  WHITEPAY_COMPLETE
  WHITEPAY_DECLINED
}

enum BalanceTransactionType {
  TRADE_CREDIT
  TRADE_PENDING_CREDIT
  TRADE_PENDING_RELEASE
  ADMIN_ADJUSTMENT
  WITHDRAWAL
  PAYOUT_REFUND
  FROZEN
  UNFROZEN
}

enum PaymentMethodType {
  SEPA
  CARD
  CRYPTO
  // Flexify specific types
  FLEXIFY_SEPA
  FLEXIFY_CARD
  // Whitepay specific type
  WHITEPAY_CRYPTO
}

enum KycStatus {
  PENDING
  VERIFIED
  REJECTED
  IN_PROGRESS
  // KYCAID specific statuses
  KYCAID_PENDING
  KYCAID_VERIFIED
  KYCAID_REJECTED
}

enum KycDocumentType {
  // Types standards
  ID_CARD
  PASSPORT
  SELFIE
  PROOF_OF_ADDRESS
  
  // Types KYCAID
  GOVERNMENT_ID
  DRIVERS_LICENSE
  DOMESTIC_PASSPORT
  PERMANENT_RESIDENCE_PERMIT
  REFUGEE_CARD
  FOREIGN_CITIZEN_PASSPORT
  SELFIE_IMAGE
  SELFIE_WITH_DOCUMENT
  SELFIE_WITH_CREDIT_CARD
  ADDRESS_DOCUMENT
  FINANCIAL_DOCUMENT
  TAX_ID_NUMBER
  CREDIT_CARD
  BANK_STATEMENT
  REGISTRATION_COMPANY
  COMPANY_LEGAL_ADDRESS
  AUTHORISED_PERSON
  COMPANY_OWNERSHIP
  VIDEO
}

enum KycFileSide {
  FRONT    // Recto
  BACK     // Verso
  SELFIE   // Photo selfie/liveness
  PROOF    // Justificatif (adresse, etc.)
}

enum KycAddressType {
  REGISTERED   // Adresse principale/officielle
  BUSINESS     // Adresse d'exploitation (KYB)
  ADDITIONAL   // Adresse secondaire
}

enum KycaidVerificationStatus {
  UNUSED       // Créé mais pas encore utilisé
  PENDING      // En attente de soumission utilisateur
  PROCESSING   // En cours de vérification
  COMPLETED    // Terminé (vérifié ou refusé)
  VERIFIED     // Vérifié avec succès (alias COMPLETED + verified=true)
  REJECTED     // Rejeté (alias DECLINED)
  DECLINED     // Refusé
}

enum AffiliatedRole {
  DIRECTOR          // Dirigeant
  UBO               // Bénéficiaire effectif (Ultimate Beneficial Owner)
  LEGAL_REP         // Représentant légal
  SHAREHOLDER       // Actionnaire
}

enum GiveawayStatus {
  ACTIVE
  ENDED
  CANCELLED
}

enum PointEventType {
  TRADE_SALE         // Vente réussie
  DAILY_LOGIN        // Connexion quotidienne
  LEVEL_UP           // Passage de niveau
  ADMIN_ADJUSTMENT   // Ajustement manuel admin
  GIVEAWAY_ENTRY     // Participation à un giveaway (dépense de tickets)
  REFERRAL_BONUS     // Bonus parrainage
}

enum UserRole {
  USER
  ADMIN
  AFFILIATE
  MODERATOR
}

enum AffiliateCommissionStatus {
  PENDING
  APPROVED
  PAID
  CANCELLED
}

enum AffiliateApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

model NewsletterSubscriber {
  id          String   @id @default(cuid())
  email       String   @unique
  isActive    Boolean  @default(true)
  subscribedAt DateTime @default(now())
  unsubscribedAt DateTime?
  unsubscribeToken String @unique @default(cuid())
  
  @@index([email])
  @@index([isActive])
  @@map("newsletter_subscriber")
}

model NewsletterCampaign {
  id          String               @id @default(cuid())
  title       String
  subject     String
  content     String
  htmlContent String?
  status      NewsletterStatus     @default(DRAFT)
  scheduledAt DateTime?
  sentAt      DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  createdBy   String
  
  sends       NewsletterSend[]
  
  @@index([status])
  @@index([scheduledAt])
  @@map("newsletter_campaign")
}

model NewsletterSend {
  id           String            @id @default(cuid())
  campaignId   String
  email        String
  status       NewsletterSendStatus @default(PENDING)
  sentAt       DateTime?
  openedAt     DateTime?
  clickedAt    DateTime?
  errorMessage String?
  
  campaign     NewsletterCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  
  @@index([campaignId])
  @@index([email])
  @@index([status])
  @@map("newsletter_send")
}

model Conversation {
  id          String   @id @default(cuid())
  userId      String?  // Nullable pour les invités
  status      ConversationStatus @default(ACTIVE)
  subject     String?
  category    String?
  priority    ConversationPriority @default(NORMAL)
  assignedTo  String?  // ID du modérateur assigné
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  closedAt    DateTime?
  
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  assignedModerator User? @relation("AssignedConversations", fields: [assignedTo], references: [id], onDelete: SetNull)
  messages    ChatMessage[]
  
  @@index([userId])
  @@index([status])
  @@index([assignedTo])
  @@index([createdAt])
  @@map("conversation")
}

model ChatMessage {
  id             String      @id @default(cuid())
  conversationId String
  userId         String?     // Nullable pour les messages système
  content        String
  senderType     SenderType
  isRead         Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  @@index([conversationId])
  @@index([userId])
  @@index([createdAt])
  @@index([senderType])
  @@map("chat_message")
}

enum NewsletterStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  CANCELLED
}

enum NewsletterSendStatus {
  PENDING
  SENT
  DELIVERED
  OPENED
  CLICKED
  BOUNCED
  FAILED
}

enum ConversationStatus {
  ACTIVE
  CLOSED
  ARCHIVED
}

enum ConversationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum SenderType {
  USER
  BOT
  MODERATOR
  SYSTEM
}

// ==========================================
// PAGES LÉGALES DYNAMIQUES
// ==========================================

model LegalPage {
  id          String   @id @default(cuid())
  slug        String   @unique // ex: "terms", "privacy", "kyc-policy", "aml-policy", "about", "press"
  
  // Contenu FR
  titleFr     String
  subtitleFr  String?
  contentFr   String   @db.Text
  
  // Contenu EN
  titleEn     String
  subtitleEn  String?
  contentEn   String   @db.Text
  
  // Contenu CN (Chinois)
  titleCn     String?
  subtitleCn  String?
  contentCn   String?  @db.Text
  
  // Métadonnées
  version     String   @default("1.0")
  isPublished Boolean  @default(true)
  
  // Informations de contact (optionnel, affiché en bas de page)
  contactEmail String?
  contactPhone String?
  
  // Audit
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedBy   String?  // ID de l'admin qui a fait la dernière modification
  
  @@index([slug])
  @@index([isPublished])
  @@map("legal_page")
}

// Historique des modifications pour traçabilité
model LegalPageHistory {
  id            String   @id @default(cuid())
  legalPageId   String
  legalPageSlug String
  
  // Snapshot du contenu
  titleFr       String
  titleEn       String
  titleCn       String?
  contentFr     String   @db.Text
  contentEn     String   @db.Text
  contentCn     String?  @db.Text
  version       String
  
  // Audit
  changedBy     String
  changedAt     DateTime @default(now())
  changeReason  String?
  
  @@index([legalPageId])
  @@index([changedAt])
  @@map("legal_page_history")
}

// Configuration du site (paramètres globaux modifiables par l'admin)
model SiteSettings {
  id                String   @id @default(cuid())
  key               String   @unique
  valueFr           String?  @db.Text
  valueEn           String?  @db.Text
  valueJson         Json?    // Pour les données structurées (ex: liens sociaux)
  description       String?
  
  updatedAt         DateTime @updatedAt
  updatedBy         String?
  
  @@index([key])
  @@map("site_settings")
}
