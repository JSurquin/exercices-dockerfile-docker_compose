generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String          @id @default(cuid())
  email            String          @unique
  emailVerified    Boolean         @default(false)
  name             String?
  image            String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  role             UserRole        @default(USER)
  steamId          String?         @unique
  steamUsername    String?
  steamAvatar      String?
  level            Int             @default(1)
  xp               Int             @default(0)
  tickets          Int             @default(0)
  totalVolumeCents Int             @default(0)
  kycStatus        KycStatus       @default(PENDING)
  acceptedTermsAt  DateTime?
  affiliateStats   AffiliateStats?
  giveawayEntries  GiveawayEntry[]
  kycDocuments     KycDocument[]
  paymentMethods   PaymentMethod[]
  payouts          Payout[]
  trades           Trade[]
  accounts         Account[]
  sessions         Session[]

  @@map("user")
}

model AuditLog {
  id              String      @id @default(cuid())
  userId          String
  action          String
  details         Json
  createdAt       DateTime    @default(now())
  ipAddress       String?

  @@index([userId])
  @@index([action])
  @@index([createdAt])

  @@map("audit_log")
}

model Trade {
  id              String      @id @default(cuid())
  userId          String
  status          TradeStatus @default(CREATED)
  grossCents      Int
  cashoutFees     Int
  networkFees     Int
  steamId         String
  netCents        Int
  ticketId        String      @unique
  tradeAcceptedAt DateTime?
  tradeUrl        String?
  expiresAt       DateTime?
  availableAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  payouts         Payout[]
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items           TradeItem[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model TradeItem {
  id             String  @id @default(cuid())
  tradeId        String
  name           String
  marketHashName String
  priceCents     Int
  iconUrl        String
  exterior       String?
  statTrak       Boolean @default(false)
  rarity         String
  trade          Trade   @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  @@index([tradeId])
}

model PaymentMethod {
  id         String            @id @default(cuid())
  userId     String
  type       PaymentMethodType
  details    Json
  isVerified Boolean           @default(false)
  isDefault  Boolean           @default(false)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  payouts    Payout[]

  @@index([userId])
}

model Payout {
  id               String        @id @default(cuid())
  userId           String
  tradeId          String?
  status           PayoutStatus  @default(PENDING)
  amountCents      Int
  paymentMethodId  String
  paymentReference String?
  txId             String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  paidAt           DateTime?
  paymentMethod    PaymentMethod @relation(fields: [paymentMethodId], references: [id])
  trade            Trade?        @relation(fields: [tradeId], references: [id])
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model KycDocument {
  id              String          @id @default(cuid())
  userId          String
  type            KycDocumentType
  status          KycStatus       @default(PENDING)
  providerId      String
  uploadedAt      DateTime        @default(now())
  reviewedAt      DateTime?
  rejectionReason String?
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model AffiliateStats {
  id                   String   @id @default(cuid())
  userId               String   @unique
  code                 String   @unique
  totalReferrals       Int      @default(0)
  totalVolumeCents     Int      @default(0)
  totalCommissionCents Int      @default(0)
  commissionRate       Float    @default(0.02)
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Giveaway {
  id          String          @id @default(cuid())
  title       String
  description String
  prize       String
  ticketPrice Int
  maxTickets  Int
  soldTickets Int             @default(0)
  endDate     DateTime
  status      GiveawayStatus  @default(ACTIVE)
  winnerId    String?
  randomSeed  String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  entries     GiveawayEntry[]

  @@index([status])
  @@index([endDate])
}

model GiveawayEntry {
  id          String   @id @default(cuid())
  userId      String
  giveawayId  String
  ticketsUsed Int
  enteredAt   DateTime @default(now())
  giveaway    Giveaway @relation(fields: [giveawayId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, giveawayId])
  @@index([giveawayId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("verification")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

enum TradeStatus {
  CREATED
  ACCEPTED_BY_BOT
  IN_TRADE_HOLD
  AVAILABLE
  PAYOUT_PENDING
  PAID
  FAILED
}

enum PayoutStatus {
  PENDING
  VERIFICATION_REQUIRED
  VERIFIED
  SCHEDULED
  PROCESSING
  PAID
  FAILED
}

enum PaymentMethodType {
  SEPA
  CRYPTO
  STRIPE
}

enum KycStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum KycDocumentType {
  ID_CARD
  PASSPORT
  SELFIE
  PROOF_OF_ADDRESS
}

enum GiveawayStatus {
  ACTIVE
  ENDED
  CANCELLED
}

enum UserRole {
  USER
  ADMIN
}
