// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Better Auth tables
model User {
  id                String    @id @default(cuid())
  email             String    @unique
  emailVerified     Boolean   @default(false)
  name              String?
  image             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  // Custom fields for CashTrade
  steamId           String?   @unique
  steamUsername     String?
  steamAvatar       String?
  level             Int       @default(1)
  xp                Int       @default(0)
  tickets           Int       @default(0)
  totalVolume       Int       @default(0) // en centimes
  kycStatus         String    @default("pending") // pending, verified, rejected
  acceptedTermsAt   DateTime?
  
  // Relations
  accounts          Account[]
  sessions          Session[]
  trades            Trade[]
  payouts           Payout[]
  kycDocuments      KYCDocument[]
  affiliateStats    AffiliateStats?
  giveawayEntries   GiveawayEntry[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  
  @@unique([identifier, token])
}

// CashTrade specific models
model Trade {
  id              String   @id @default(cuid())
  userId          String
  status          String   // créé, accepté_par_bot, en_trade_hold, disponible, paiement_en_cours, payé, échoué
  brutCentimes    Int
  fraisCashout    Int
  fraisReseau     Int
  netCentimes     Int
  ticketId        String   @unique
  tradeAcceptéLe  DateTime?
  disponibleLe    DateTime?
  créédLe         DateTime @default(now())
  
  user            User @relation(fields: [userId], references: [id], onDelete: Cascade)
  items           TradeItem[]
  payouts         Payout[]
}

model TradeItem {
  id              String   @id @default(cuid())
  tradeId         String
  name            String
  marketHashName  String
  prixCentimes    Int
  iconUrl         String
  exterior        String?
  statTrak        Boolean  @default(false)
  rarity          String
  
  trade           Trade @relation(fields: [tradeId], references: [id], onDelete: Cascade)
}

model PaymentMethod {
  id              String   @id @default(cuid())
  userId          String
  type            String   // sepa, crypto, stripe
  details         Json     // IBAN, crypto address, etc.
  isVerified      Boolean  @default(false)
  isDefault       Boolean  @default(false)
  createdAt       DateTime @default(now())
  
  payouts         Payout[]
}

model Payout {
  id                  String   @id @default(cuid())
  userId              String
  tradeId             String?
  status              String   // en_attente, vérification_requise, vérifié, planifié, exécuté, payé, échoué
  montantCentimes     Int
  methodePaiementId   String
  referencePaiement   String?
  txId                String?
  créédLe             DateTime @default(now())
  payéLe              DateTime?
  
  user                User @relation(fields: [userId], references: [id], onDelete: Cascade)
  trade               Trade? @relation(fields: [tradeId], references: [id], onDelete: SetNull)
  methodePaiement     PaymentMethod @relation(fields: [methodePaiementId], references: [id])
}

model KYCDocument {
  id              String   @id @default(cuid())
  userId          String
  type            String   // id_card, passport, selfie, proof_of_address
  status          String   // pending, approved, rejected
  providerId      String
  uploadedAt      DateTime @default(now())
  reviewedAt      DateTime?
  rejectionReason String?
  
  user            User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AffiliateStats {
  id                      String   @id @default(cuid())
  userId                  String   @unique
  code                    String   @unique
  totalReferrals          Int      @default(0)
  totalVolumeCentimes     Int      @default(0)
  totalCommissionCentimes Int      @default(0)
  commissionRate          Float    @default(0.02) // 2%
  isActive                Boolean  @default(true)
  createdAt               DateTime @default(now())
  
  user                    User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Giveaway {
  id              String   @id @default(cuid())
  title           String
  description     String
  prize           String
  ticketPrice     Int
  maxTickets      Int
  soldTickets     Int      @default(0)
  endDate         DateTime
  status          String   // active, ended, cancelled
  winnerId        String?
  randomSeed      String?
  createdAt       DateTime @default(now())
  
  entries         GiveawayEntry[]
}

model GiveawayEntry {
  id              String   @id @default(cuid())
  userId          String
  giveawayId      String
  ticketsUsed     Int
  enteredAt       DateTime @default(now())
  
  user            User @relation(fields: [userId], references: [id], onDelete: Cascade)
  giveaway        Giveaway @relation(fields: [giveawayId], references: [id], onDelete: Cascade)
}
