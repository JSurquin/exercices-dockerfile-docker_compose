model Notification {
  id          String               @id @default(cuid())
  userId      String
  type        NotificationType
  priority    NotificationPriority @default(NORMAL)
  titleFr     String
  titleEn     String
  messageFr   String
  messageEn   String
  titleCn     String?
  messageCn   String?
  link        String?
  metadata    Json?
  read        Boolean              @default(false)
  readAt      DateTime?
  createdAt   DateTime             @default(now())
  expiresAt   DateTime?
  createdBy   String?
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt])
  @@index([type])
  @@index([priority])
  @@map("notification")
}

model NotificationPreferences {
  id                   String   @id @default(cuid())
  userId               String   @unique
  emailNotifications   Boolean  @default(true)
  pushNotifications    Boolean  @default(false)
  tradeAlerts          Boolean  @default(true)
  payoutAlerts         Boolean  @default(true)
  kycAlerts            Boolean  @default(true)
  giveawayAlerts       Boolean  @default(true)
  missionAlerts        Boolean  @default(true)
  marketingEmails      Boolean  @default(false)
  securityAlerts       Boolean  @default(true)
  systemAnnouncements  Boolean  @default(true)
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

/// Taux de change journaliers sauvegardés pour fallback en cas d'indisponibilité de l'API Frankfurter
model ExchangeRate {
  id           String   @id @default(cuid())
  fromCurrency String
  toCurrency   String
  rate         Float
  date         String   // YYYY-MM-DD
  source       String   @default("frankfurter") // "frankfurter" | "fallback"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([fromCurrency, toCurrency, date])
  @@index([fromCurrency, toCurrency, createdAt])
  @@map("exchange_rates")
}

/// Vidéos partenaires / créateurs affichées sur la page d'accueil
model PartnerVideo {
  id                String   @id @default(cuid())
  youtubeVideoUrl   String
  youtubeVideoId    String
  creatorName       String
  subscriberCount   String?
  avatarUrl         String?
  youtubeChannelUrl String?
  twitterUrl        String?
  sortOrder         Int      @default(0)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("partner_video")
}

/// Logos partenaires affichés sous les vidéos sur la page d'accueil
model PartnerLogo {
  id         String   @id @default(cuid())
  name       String
  logoUrl    String
  profileUrl String?
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("partner_logo")
}

/// Idempotence des webhooks (Flexify, Skinplace, etc.)
model WebhookEvent {
  id           String    @id @default(cuid())
  webhookId    String
  handler      String
  status       String    @default("processing")
  receivedAt   DateTime  @default(now())
  processedAt  DateTime?
  errorMessage String?
  metadata     Json?

  @@unique([webhookId, handler])
  @@map("webhook_event")
}
