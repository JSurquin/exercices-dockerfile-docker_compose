    "framer-motion": "^12.23.16",
    "highlight.js": "^11.12.0",
    "import-in-the-middle": "^3.0.0",
    "input-otp": "^1.4.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.544.0",
    "next": "15.5.25",
    "next-intl": "^4.13.0",
    "next-themes": "^0.4.6",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.4",
    "pg": "^8.21.0",
    "puppeteer": "^24.22.3",
    "qrcode.react": "^4.2.0",
    "react": "19.1.0",
    "react-countup": "^6.5.3",
    "react-day-picker": "^9.11.0",
