{
  "name": "counter-strike-skin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:wait": "docker compose up -d --wait",
    "docker:rag:up": "docker compose -f docker-compose.rag.yml up -d",
    "docker:rag:down": "docker compose -f docker-compose.rag.yml down",
    "db:migrate": "prisma migrate deploy",
    "dev:setup": "docker compose up -d --wait && prisma migrate deploy && tsx prisma/seed.ts",
    "cron:worker": "tsx scripts/cron-worker.ts",
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "db:seed": "tsx prisma/seed.ts",
    "rag:seed": "tsx scripts/seed-rag.ts",
    "db:repair-migration-name": "prisma db execute --file prisma/migrations/REPAIR_flexify_kycaid_rename.sql --schema prisma/schema.prisma",
    "lint": "eslint",
    "check": "prisma generate && eslint ; npx tsc --noEmit",
    "test": "jest",
    "test:coverage:chat": "jest --coverage --forceExit --collectCoverageFrom='src/lib/chat*.ts' --collectCoverageFrom='src/lib/chat-client-types.ts' --collectCoverageFrom='src/hooks/use-chat.ts' --collectCoverageFrom='src/components/ui/chat-widget.tsx' --testPathPatterns=chat --coverageReporters=text-summary --coverageReporters=text",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:smoke": "playwright test --project=smoke",
    "test:e2e:logged-out": "playwright test --project=logged-out",
    "test:e2e:logged-in": "playwright test --project=logged-in",
    "test:e2e:admin": "playwright test --project=admin",
    "test:e2e:chat": "playwright test chat.logged-out chat.logged-in chat.moderation",
    "test:e2e:mobile": "playwright test --project=mobile",
    "test:e2e:sell": "playwright test workflow-sell",
    "test:e2e:payout": "playwright test workflow-payout",
    "test:e2e:kyc": "playwright test workflow-kyc",
    "test:e2e:giveaways": "playwright test giveaways",
    "test:e2e:affiliation": "playwright test affiliation",
    "test:e2e:gamification": "playwright test gamification",
    "test:e2e:notifications": "playwright test notifications",
    "test:e2e:forms": "playwright test forms",
    "test:e2e:security": "playwright test security",
    "test:e2e:accessibility": "playwright test accessibility",
    "test:e2e:performance": "playwright test performance-seo",
    "test:e2e:report": "playwright show-report",
    "test:e2e:install": "playwright install",
    "test:e2e:cleanup": "tsx scripts/cleanup-test-users.ts",
    "support:clear": "tsx scripts/clear-support-conversations.ts",
    "security:owasp": "bash scripts/owasp-scan.sh"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "5.22.0",
    "@radix-ui/react-accordion": "^1.2.12",
