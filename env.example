# Better Auth Configuration
BETTER_AUTH_SECRET=your-secret-key-here
BETTER_AUTH_URL=http://localhost:3000

# Discord OAuth
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret

# Steam API
STEAM_API_KEY=your-steam-api-key

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Chat IA (Ollama — local sur le serveur, port 11434 par défaut)
# Désactivé par défaut : ne pas activer en prod sans validation équipe.
CHAT_AI_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Base RAG (PostgreSQL + pgvector — séparée de Prisma, pour le futur chatbot RAG)
# Démarrer avec : pnpm run docker:rag:up
RAG_DATABASE_URL=postgresql://moonskin_rag:moonskin_rag_dev@localhost:5433/moonskin_rag

# Database
DATABASE_URL=postgresql://username:password@localhost:5432/cashtrade_dev

# Stripe
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret
STRIPE_WEBHOOK_ENDPOINT_SECRET=whsec_your-webhook-endpoint-secret

# Skinplace API
SKINPLACE_API_KEY=your-skinplace-api-key
SKINPLACE_API_KEY_PRIVATE=your-skinplace-private-key
SKINPLACE_API_KEY_PUBLIC=your-skinplace-public-key
SKINPLACE_API_URL=https://api.skin.place

# Email Configuration (Newsletter)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM_NAME=MoonSkin
SMTP_FROM_EMAIL=noreply@moonskin.com

# Flexify Payout Configuration (H2H API)
# Récupérez vos clés dans la section "Projects" du portail marchand Flexify
FLEXIFY_API_KEY=your-flexify-api-key
FLEXIFY_API_SECRET=your-flexify-api-secret
FLEXIFY_MERCHANT_IDENTIFIER=MR_TEST # Ex: MR_TEST pour sandbox, MR_XXXX pour production
# URLs selon la spec H2H
FLEXIFY_H2H_URL=https://h2h.flexify.finance
FLEXIFY_API_URL=https://api.flexify.finance
FLEXIFY_ENVIRONMENT=sandbox # sandbox ou production
# URLs de callback
FLEXIFY_CALLBACK_URL=http://localhost:3000/api/flexify/webhook
FLEXIFY_SUCCESS_URL=http://localhost:3000/dashboard?payout=success
FLEXIFY_FAILURE_URL=http://localhost:3000/dashboard?payout=failed

# Whitepay Configuration
WHITEPAY_API_KEY=your-whitepay-api-key
WHITEPAY_SECRET_KEY=your-whitepay-secret-key
WHITEPAY_BASE_URL=https://api.whitepay.com
WHITEPAY_CALLBACK_URL=http://localhost:3000/api/whitepay/webhook

# Sentry (Monitoring & Error Tracking)
# Créez un compte sur https://sentry.io et récupérez ces valeurs
NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
# Optionnel : pour l'upload des source maps (CI/CD)
SENTRY_AUTH_TOKEN=sntrys_xxx
# Optionnel : override des valeurs par défaut
SENTRY_ORG=moonskin
SENTRY_PROJECT=counter-strike-skin

# KYCAID Configuration
KYCAID_API_TOKEN=your-kycaid-api-token
KYCAID_FORM_ID=your-kycaid-form-id
KYCAID_BASE_URL=https://api.kycaid.com
KYCAID_SANDBOX_MODE=true
# En prod, mettre l'URL publique. En dev sans tunnel, laisser vide pour utiliser le polling.
KYCAID_CALLBACK_URL=
KYCAID_REDIRECT_URL=http://localhost:3000/kyc/complete
